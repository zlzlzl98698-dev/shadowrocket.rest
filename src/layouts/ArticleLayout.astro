---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import TableOfContents from '@/components/article/TableOfContents.astro';
import FAQSection from '@/components/common/FAQSection.astro';
import ArticleSources from '@/components/article/ArticleSources.astro';
import RelatedArticles from '@/components/article/RelatedArticles.astro';
import BrandCTA from '@/components/review/BrandCTA.astro';
import DisclosureBanner from '@/components/common/DisclosureBanner.astro';
import { getPillarByKey, getTopicBySlug } from '@/data/navigation';
import { SITE } from '@/data/site';
import { estimateReadingMinutes, formatZhDate, type AnyEntry } from '@/utils/content';
import { getPillarBreadcrumbLabel, toSocialImageUrl } from '@/utils/seo';

export interface Props {
  entry: AnyEntry;
  headings: { depth: number; slug: string; text: string }[];
  relatedEntries: AnyEntry[];
}

const { entry, headings, relatedEntries } = Astro.props;
const pillar = getPillarByKey(entry.data.pillar);
const topic = getTopicBySlug(entry.data.pillar, entry.data.topicSlug);
const readMinutes = estimateReadingMinutes(entry.body);
const pubDateStr = formatZhDate(entry.data.pubDate);
const updatedDateStr = entry.data.updatedDate ? formatZhDate(entry.data.updatedDate) : pubDateStr;
const socialImageUrl = toSocialImageUrl(entry.data.cover, SITE.url);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  image: socialImageUrl,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Organization',
    name: entry.data.author,
    url: new URL('/about/', SITE.url).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logos/site-avatar.webp', SITE.url).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, SITE.url).toString(),
  },
};

const pillarLabel = getPillarBreadcrumbLabel(pillar.key, pillar.name, topic?.name);
const breadcrumbItems = [
  { label: pillarLabel, href: pillar.href },
  ...(topic ? [{ label: topic.name, href: topic.href }] : []),
  { label: entry.data.title },
];
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.description}
  canonical={entry.data.canonical}
  ogType="article"
  ogImage={entry.data.cover}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  schemas={[articleSchema]}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumb items={breadcrumbItems} />

    <div class="grid gap-10 lg:grid-cols-12 items-start">
      <article class="lg:col-span-8 min-w-0" data-pagefind-body>
        <header class="mb-7">
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
            <a
              href={topic ? topic.href : pillar.href}
              class="rounded-full bg-[var(--brand-blue-soft)] px-3 py-1 font-semibold text-[var(--brand-blue)] hover:underline"
            >
              {entry.data.category}
            </a>
            {entry.data.tags.slice(0, 4).map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="rounded-full border border-[var(--border-color)] bg-white px-2.5 py-0.5 text-[var(--text-secondary)] hover:border-[var(--brand-blue)]"
              >
                #{tag}
              </a>
            ))}
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-[var(--brand-navy)]">
            {entry.data.title}
          </h1>

          <p class="mt-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-4 sm:p-5 text-base leading-relaxed text-[var(--text-primary)]">
            <strong class="text-[var(--brand-blue)]">核心摘要：</strong>
            {entry.data.excerpt ?? entry.data.description}
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm text-[var(--text-secondary)]">
            <span>作者：<strong class="text-[var(--text-primary)]">{entry.data.author}</strong></span>
            <span>发布：<time datetime={entry.data.pubDate.toISOString()}>{pubDateStr}</time></span>
            <span>更新：<time datetime={(entry.data.updatedDate ?? entry.data.pubDate).toISOString()}>{updatedDateStr}</time></span>
            <span>预计阅读：{readMinutes} 分钟</span>
          </div>
        </header>

        <figure class="mb-7 overflow-hidden rounded-2xl border border-[var(--border-color)] bg-slate-900">
          <img
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? entry.data.title}
            width="1200"
            height="630"
            class="aspect-16/9 w-full object-cover"
            loading="eager"
          />
        </figure>

        <!-- Mobile collapsible TOC -->
        {headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 0 && (
          <details class="mb-7 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-4 lg:hidden">
            <summary class="cursor-pointer font-bold text-sm text-[var(--text-primary)]">
              展开本文目录
            </summary>
            <div class="mt-3">
              <TableOfContents headings={headings} />
            </div>
          </details>
        )}

        <div class="prose-editorial">
          <slot />
        </div>

        <FAQSection items={entry.data.faq} />

        <ArticleSources
          sources={entry.data.sources}
          verifiedDate={entry.data.verifiedDate}
          testDate={entry.data.testDate}
          reviewStatus={entry.data.reviewStatus}
        />

        {entry.data.brandSlugs.length > 0 && (
          <div class="mt-6">
            <BrandCTA brandSlug={entry.data.brandSlugs[0]} />
          </div>
        )}

        <div class="mt-6">
          <DisclosureBanner compact />
        </div>

        <RelatedArticles entries={relatedEntries} title="下一步阅读建议与相关文章" />
      </article>

      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-22" data-pagefind-ignore>
        <TableOfContents headings={headings} />

        {topic && (
          <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">所属核心专题</div>
            <h3 class="mt-1 text-base font-bold text-[var(--text-primary)]">{topic.name}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-secondary)]">{topic.shortDesc}</p>
            <a
              href={topic.href}
              class="mt-3 inline-flex text-xs font-semibold text-[var(--brand-blue)] hover:underline"
            >
              浏览本专题全部内容 →
            </a>
          </div>
        )}

        <div class="rounded-2xl border border-[var(--border-color)] bg-white p-5">
          <h3 class="text-sm font-bold text-[var(--text-primary)]">31 家机场品牌库检索</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-[var(--text-secondary)]">
            按价格、IEPL/IPLC 专线、协议、AI 工具与流媒体解锁情况快速筛选并核对套餐真伪。
          </p>
          <a
            href="/brands/"
            class="mt-3 inline-flex w-full items-center justify-center rounded-xl bg-[var(--brand-blue-soft)] px-4 py-2 text-xs font-semibold text-[var(--brand-blue)] hover:bg-[var(--brand-blue)] hover:text-white transition-colors"
          >
            进入品牌数据库 →
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
