---
import ArticleLayout from './ArticleLayout.astro';
import type { AnyEntry } from '@/utils/content';

export interface Props {
  entry: AnyEntry;
  headings: { depth: number; slug: string; text: string }[];
  relatedEntries: AnyEntry[];
}

const { entry, headings, relatedEntries } = Astro.props;
const platforms = 'platforms' in entry.data ? entry.data.platforms : [];
const difficulty = 'difficulty' in entry.data ? entry.data.difficulty : '入门';
---

<ArticleLayout entry={entry} headings={headings} relatedEntries={relatedEntries}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/50 p-4 text-xs sm:text-sm">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-emerald-600 px-3 py-0.5 font-semibold text-white">
        {difficulty}教程
      </span>
      {platforms.map((p) => (
        <span class="rounded-full bg-white border border-emerald-200 px-2.5 py-0.5 font-medium text-emerald-900">
          {p}
        </span>
      ))}
    </div>
    <a href="/clients/" class="font-semibold text-[var(--brand-blue)] hover:underline">
      查看全平台客户端支持表 →
    </a>
  </div>

  <slot />
</ArticleLayout>
