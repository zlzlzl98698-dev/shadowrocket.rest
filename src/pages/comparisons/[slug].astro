---
import { getCollection, render } from 'astro:content';
import ComparisonLayout from '@/layouts/ComparisonLayout.astro';
import { findRelatedEntries, getAllPublishedEntries, getEntrySlug } from '@/utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('comparisons', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getAllPublishedEntries();
const typedEntry = { ...entry, kind: 'comparisons' as const };
const relatedEntries = findRelatedEntries(typedEntry, all, 4);
---

<ComparisonLayout entry={typedEntry} headings={headings} relatedEntries={relatedEntries}>
  <Content />
</ComparisonLayout>
