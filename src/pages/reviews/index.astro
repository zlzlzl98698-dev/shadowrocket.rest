---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import ReviewCard from '@/components/cards/ReviewCard.astro';
import BrandCard from '@/components/cards/BrandCard.astro';
import { ALL_BRANDS } from '@/data/brands';
import { getAllPublishedEntries } from '@/utils/content';
import { SITE } from '@/data/site';

const all = await getAllPublishedEntries();
const reviews = all.filter((e) => e.kind === 'reviews');
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '机场品牌深度评测报告归档',
  url: new URL('/reviews/', SITE.url).toString(),
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  title="机场品牌深度评测报告归档"
  description="汇总配备实测数据、套餐核查与解锁矩阵的深度品牌评测文章，并可直达 31 家独立品牌评测档案。"
  schemas={[collectionSchema]}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 space-y-12">
    <div>
      <Breadcrumb items={[{ label: '深度评测' }]} />
      <h1 class="text-3xl font-extrabold text-[var(--brand-navy)]">品牌深度评测报告</h1>
      <p class="mt-2 text-base text-[var(--text-secondary)]">
        结合 MiaoKo 实测截图、历史版本差异核查与适用边界分析。
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reviews.map((entry) => (
          <ReviewCard entry={entry} />
        ))}
      </div>
    </div>

    <section>
      <div class="mb-4 flex items-end justify-between">
        <h2 class="text-2xl font-bold text-[var(--brand-navy)]">全部 31 家品牌独立评测档案</h2>
        <a href="/brands/" class="text-sm font-semibold text-[var(--brand-blue)] hover:underline">
          按条件筛选品牌 →
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {ALL_BRANDS.slice(0, 9).map((brand) => (
          <BrandCard brand={brand} compact />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
