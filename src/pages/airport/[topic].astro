---
import TopicPageRenderer from '@/components/topic/TopicPageRenderer.astro';
import { getPillarByKey, getTopicBySlug } from '@/data/navigation';

export function getStaticPaths() {
  const pillar = getPillarByKey('airport');
  return pillar.items.map((item) => ({
    params: { topic: item.slug },
  }));
}

const { topic: topicSlug } = Astro.params;
const pillar = getPillarByKey('airport');
const topic = getTopicBySlug('airport', topicSlug)!;
---

<TopicPageRenderer pillar={pillar} topic={topic} />
