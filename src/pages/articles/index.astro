---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import { getAllPublishedEntries } from '@/utils/content';
import { SITE } from '@/data/site';

const all = await getAllPublishedEntries();
const articles = all.filter((e) => e.kind === 'articles');
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '深度专栏与选型知识库文章列表',
  url: new URL('/articles/', SITE.url).toString(),
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  title="深度专栏与选型知识库文章列表"
  description="浏览小火箭（shadowrocket.rest）全部原创深度专栏：涵盖 2026 机场选型、性价比拆解、IEPL/IPLC 线路原理、代理协议、AI 解锁与风控审计。"
  schemas={[collectionSchema]}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '深度专栏' }]} />
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-[var(--brand-navy)]">深度专栏与行业解析（{articles.length} 篇）</h1>
      <p class="mt-2 text-base text-[var(--text-secondary)]">
        采用 Answer-First 结构撰写，直接解答选型、计费、协议与风险疑问。
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </div>
</BaseLayout>
