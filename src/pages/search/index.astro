---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
---

<BaseLayout
  title="站内全文搜索 — 检索文章、机场评测、品牌参数与教程"
  description="使用 Pagefind 静态全文索引检索小火箭（shadowrocket.rest）站内全部中文文章、31 家品牌详情、客户端教程与排错文档。"
  noindex={true}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-ignore>
    <Breadcrumb items={[{ label: '站内全文搜索' }]} />

    <div class="mb-8 rounded-3xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6 sm:p-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--brand-navy)]">
        站内全文搜索
      </h1>
      <p class="mt-2 text-sm sm:text-base text-[var(--text-secondary)]">
        支持中文关键词检索全站已发布的评测文章、31 家品牌数据库、Clash / 小火箭教程与故障排查手册。
      </p>

      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <div class="relative flex-1">
          <input
            id="pagefind-search-input"
            type="search"
            placeholder="输入关键词，例如：光速云、IEPL、Clash Verge、订阅失败、Gemini..."
            class="w-full rounded-2xl border border-[var(--border-strong)] bg-white py-3 pl-4 pr-20 text-base text-[var(--text-primary)] shadow-2xs focus:border-[var(--brand-blue)] focus:outline-none"
          />
          <button
            id="pagefind-clear-btn"
            type="button"
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-200 cursor-pointer"
          >
            清空
          </button>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-[var(--text-secondary)]">
        <span>热门搜索：</span>
        {['光速云', '性价比机场', 'Clash Verge', 'Shadowrocket', '订阅失败', 'Gemini'].map((tag) => (
          <button
            type="button"
            data-quick-query={tag}
            class="rounded-full border border-[var(--border-color)] bg-white px-3 py-1 hover:border-[var(--brand-blue)] hover:text-[var(--brand-blue)] transition-colors cursor-pointer"
          >
            {tag}
          </button>
        ))}
      </div>
    </div>

    <div id="search-status" class="mb-4 text-sm text-[var(--text-secondary)]">
      请输入关键词开始检索（索引将在输入后即时加载）。
    </div>

    <div id="search-results" class="space-y-4"></div>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('pagefind-search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('pagefind-clear-btn');
  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results');

  let pagefind: any = null;

  async function initPagefind() {
    if (pagefind) return pagefind;
    try {
      const pfPath = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pfPath);
      await pagefind.init();
      return pagefind;
    } catch {
      if (statusEl) {
        statusEl.textContent =
          '提示：Pagefind 搜索索引仅在生产构建（npm run build）后的静态产物中可用；开发模式下可使用 /brands/ 或顶部专题浏览内容。';
      }
      return null;
    }
  }

  async function runSearch(query: string) {
    const trimmed = query.trim();
    if (clearBtn) clearBtn.classList.toggle('hidden', trimmed.length === 0);

    if (!trimmed) {
      if (statusEl) statusEl.textContent = '请输入关键词开始检索。';
      if (resultsEl) resultsEl.innerHTML = '';
      return;
    }

    if (statusEl) statusEl.textContent = `正在检索「${trimmed}」...`;

    const pf = await initPagefind();
    if (!pf) return;

    const search = await pf.search(trimmed);
    const results = await Promise.all(search.results.slice(0, 20).map((r: any) => r.data()));

    if (results.length === 0) {
      if (statusEl) statusEl.textContent = `未找到与「${trimmed}」直接匹配的结果。`;
      if (resultsEl) {
        resultsEl.innerHTML = `
          <div class="rounded-2xl border border-dashed border-[var(--border-strong)] bg-[var(--bg-secondary)] p-8 text-center">
            <p class="font-semibold text-[var(--text-primary)]">没有找到匹配内容</p>
            <p class="mt-2 text-sm text-[var(--text-secondary)]">建议尝试缩短关键词，或前往 <a href="/brands/" class="text-[var(--brand-blue)] underline">31 家品牌数据库</a> 与 <a href="/clients/" class="text-[var(--brand-blue)] underline">客户端大全</a> 浏览。</p>
          </div>
        `;
      }
      return;
    }

    if (statusEl) statusEl.textContent = `找到 ${search.results.length} 条相关结果（展示前 ${results.length} 条）：`;
    if (resultsEl) {
      resultsEl.innerHTML = results
        .map(
          (item: any) => `
          <article class="editorial-card p-5">
            <h2 class="text-lg font-bold text-[var(--text-primary)]">
              <a href="${item.url}" class="hover:text-[var(--brand-blue)] transition-colors">${item.meta?.title ?? item.url}</a>
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">${item.excerpt ?? ''}</p>
            <div class="mt-3 flex items-center justify-between text-xs text-[var(--text-muted)]">
              <span>${item.url}</span>
              <a href="${item.url}" class="font-semibold text-[var(--brand-blue)] hover:underline">查看详情 →</a>
            </div>
          </article>
        `
        )
        .join('');
    }
  }

  let timer: number | undefined;
  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => runSearch(input.value), 180);
  });

  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
    }
    runSearch('');
  });

  document.querySelectorAll<HTMLButtonElement>('[data-quick-query]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = btn.dataset.quickQuery ?? '';
      if (input) input.value = q;
      runSearch(q);
    });
  });

  // Read initial ?q= param
  const urlParams = new URLSearchParams(window.location.search);
  const initialQ = urlParams.get('q') ?? '';
  if (initialQ && input) {
    input.value = initialQ;
    runSearch(initialQ);
  }
</script>
