---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchBox from '@/components/search/SearchBox.astro';
---

<BaseLayout
  title="页面未找到 (404)"
  description="您访问的页面可能已移动或不存在，请通过搜索或核心栏目入口继续浏览。"
  noindex={true}
  omitCanonical={true}
>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <span class="inline-block rounded-full bg-[var(--brand-blue-soft)] px-4 py-1 text-xs font-bold text-[var(--brand-blue)]">
      HTTP 404 · PAGE NOT FOUND
    </span>
    <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold text-[var(--brand-navy)]">
      抱歉，该页面不存在或已迁移
    </h1>
    <p class="mt-3 text-base text-[var(--text-secondary)]">
      你可以输入关键词搜索全站内容，或直接进入下方核心频道。
    </p>

    <div class="mt-7 max-w-lg mx-auto">
      <SearchBox />
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm font-semibold">
      <a href="/" class="rounded-xl bg-[var(--brand-blue)] px-5 py-2.5 text-white hover:bg-[var(--brand-blue-hover)]">
        返回首页
      </a>
      <a href="/brands/" class="rounded-xl border border-[var(--border-strong)] bg-white px-5 py-2.5 text-[var(--text-primary)] hover:border-[var(--brand-blue)]">
        31 家品牌数据库
      </a>
      <a href="/airport/" class="rounded-xl border border-[var(--border-strong)] bg-white px-5 py-2.5 text-[var(--text-primary)] hover:border-[var(--brand-blue)]">
        机场推荐专题
      </a>
      <a href="/clients/" class="rounded-xl border border-[var(--border-strong)] bg-white px-5 py-2.5 text-[var(--text-primary)] hover:border-[var(--brand-blue)]">
        客户端大全
      </a>
    </div>
  </div>
</BaseLayout>
