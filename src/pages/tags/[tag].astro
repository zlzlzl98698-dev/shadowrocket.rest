---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import { getAllPublishedEntries } from '@/utils/content';

export async function getStaticPaths() {
  const all = await getAllPublishedEntries();
  const tagMap = new Map<string, typeof all>();
  for (const entry of all) {
    for (const tag of entry.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(entry);
    }
  }
  return Array.from(tagMap.entries()).map(([tag, entries]) => ({
    params: { tag },
    props: { tag, entries },
  }));
}

const { tag, entries } = Astro.props;
const isThinArchive = entries.length < 3;
---

<BaseLayout
  title={`标签：#${tag} — 相关评测与教程归档`}
  description={`浏览小火箭（shadowrocket.rest）中所有标记为 #${tag} 的原创评测、对比分析与配置教程。`}
  noindexFollow={isThinArchive}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: '深度专栏', href: '/articles/' }, { label: `#${tag}` }]} />
    <h1 class="mb-2 text-3xl font-extrabold text-[var(--brand-navy)]">标签归档：#{tag}</h1>
    <p class="mb-8 text-sm text-[var(--text-secondary)]">共收录 {entries.length} 篇相关内容。</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </div>
</BaseLayout>
