---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQItem[];
  title?: string;
  includeSchema?: boolean;
}

const {
  items = [],
  title = '常见问题解答（FAQ）',
  includeSchema = true,
} = Astro.props;

const faqSchema =
  includeSchema && items.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: items.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;
---

{items.length > 0 && (
  <section class="mt-10 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-6 md:p-8" aria-labelledby="faq-heading">
    <div class="mb-5 flex items-center justify-between gap-4">
      <h2 id="faq-heading" class="text-xl md:text-2xl font-bold text-[var(--text-primary)]">
        {title}
      </h2>
      <span class="rounded-full bg-[var(--brand-blue-soft)] px-3 py-1 text-xs font-semibold text-[var(--brand-blue)]">
        {items.length} 条问答
      </span>
    </div>
    <div class="space-y-3">
      {items.map((item, idx) => (
        <details
          class="group rounded-xl border border-[var(--border-color)] bg-white p-4 md:p-5 transition-colors open:border-blue-200"
          open={idx === 0}
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-[var(--text-primary)]">
            <span>{item.question}</span>
            <span class="mt-0.5 shrink-0 text-[var(--brand-blue)] transition-transform group-open:rotate-180" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 border-t border-slate-100 pt-3 text-sm md:text-base leading-relaxed text-[var(--text-secondary)]">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </section>
)}
