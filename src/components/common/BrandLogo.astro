---
export interface Props {
  name: string;
  logo?: string;
  accentColor?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  name,
  logo = '',
  accentColor = '#2563EB',
  size = 'md',
} = Astro.props;

const sizeClasses = {
  sm: 'h-10 w-10 text-sm rounded-xl',
  md: 'h-12 w-12 text-base rounded-xl',
  lg: 'h-16 w-16 text-xl rounded-2xl',
}[size];

const initial = name.replace(/[^\u4e00-\u9fa5A-Za-z0-9]/g, '').slice(0, 2) || 'SR';
---

{logo ? (
  <div class:list={['shrink-0 overflow-hidden border border-[var(--border-color)] bg-white flex items-center justify-center', sizeClasses]}>
    <img
      src={logo}
      alt={`${name} 品牌图标`}
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>
) : (
  <div
    class:list={['shrink-0 flex items-center justify-center font-bold text-white shadow-xs select-none', sizeClasses]}
    style={`background-color: ${accentColor};`}
    aria-hidden="true"
  >
    {initial}
  </div>
)}
