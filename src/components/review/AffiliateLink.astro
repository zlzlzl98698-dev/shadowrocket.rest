---
import { getBrandAffiliate } from '@/data/brands/links';
import { SITE } from '@/data/site';

export interface Props {
  brandSlug: string;
  label?: string;
  showDisclosure?: boolean;
  variant?: 'primary' | 'outline';
}

const {
  brandSlug,
  label,
  showDisclosure = true,
  variant = 'primary',
} = Astro.props;

const aff = getBrandAffiliate(brandSlug);
---

{aff ? (
  <div class="inline-flex flex-col gap-1.5">
    <a
      href={aff.registerUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class:list={[
        'inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold transition-colors',
        variant === 'primary'
          ? 'bg-[var(--brand-blue)] text-white hover:bg-[var(--brand-blue-hover)] shadow-xs'
          : 'border border-[var(--brand-blue)] bg-white text-[var(--brand-blue)] hover:bg-[var(--brand-blue-soft)]',
      ]}
    >
      <span>{label ?? `前往 ${aff.brandName} 官网入口`}</span>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5z" clip-rule="evenodd" />
        <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.056 8.194a.75.75 0 00-.053 1.06z" clip-rule="evenodd" />
      </svg>
    </a>

    {aff.couponCode && (
      <div class="text-xs text-[var(--text-secondary)]">
        参考优惠码：<code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[var(--text-primary)]">{aff.couponCode}</code>
        {aff.secondaryCouponCode && (
          <span> / <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono">{aff.secondaryCouponCode}</code></span>
        )}
      </div>
    )}

    {aff.urlFormatWarning && (
      <p class="text-xs text-amber-700">{aff.urlFormatWarning}</p>
    )}

    {showDisclosure && (
      <p class="text-[11px] leading-snug text-[var(--text-muted)]">
        {SITE.disclosure.short}
      </p>
    )}
  </div>
) : (
  <span class="text-xs text-[var(--text-muted)]">该品牌注册入口待核实</span>
)}
