---
import { SITE } from '@/data/site';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
---

<header class="sticky top-0 z-40 border-b border-[var(--border-color)] bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <img src="/logos/site-avatar.webp" alt={`${SITE.name} 标志`} class="h-9 w-9 rounded-xl border border-slate-200/80 object-cover shadow-2xs transition-transform group-hover:scale-105" />
        <div class="leading-tight">
          <div class="text-base font-bold tracking-tight text-[var(--text-primary)]">{SITE.name}</div>
          <div class="hidden sm:block text-[11px] font-medium text-[var(--text-secondary)]">{SITE.domain}</div>
        </div>
      </a>

      <Navigation />
    </div>

    <div class="flex items-center gap-2.5">
      <form action="/search/" method="get" class="hidden md:flex items-center relative">
        <label for="header-search-input" class="sr-only">站内搜索</label>
        <input
          id="header-search-input"
          type="search"
          name="q"
          placeholder="搜索测评、教程、关键词..."
          class="w-48 xl:w-64 rounded-full border border-[var(--border-color)] bg-[var(--bg-secondary)] py-1.5 pl-9 pr-3.5 text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:border-[var(--brand-blue)] focus:bg-white focus:outline-none transition-all"
        />
        <svg
          class="pointer-events-none absolute left-3 h-4 w-4 text-[var(--text-muted)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-3.35z" />
        </svg>
      </form>

      <a
        href="/search/"
        aria-label="站内搜索"
        class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[var(--border-color)] text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 1010.5 18a7.5 7.5 0 006.15-3.35z" />
        </svg>
      </a>

      <button
        id="mobile-menu-open"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
        class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[var(--border-color)] text-[var(--text-primary)] hover:bg-[var(--bg-secondary)] cursor-pointer"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const panel = document.getElementById('mobile-menu-panel');

  function setMenu(open: boolean) {
    if (!panel || !openBtn) return;
    if (open) {
      panel.classList.remove('hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    } else {
      panel.classList.add('hidden');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  backdrop?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
