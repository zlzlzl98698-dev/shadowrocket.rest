---
import type { AnyEntry } from '@/utils/content';
import { estimateReadingMinutes, formatZhDate, getEntryUrl } from '@/utils/content';

export interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const url = getEntryUrl(entry);
const readMinutes = estimateReadingMinutes(entry.body);
---

<article class="editorial-card p-4 sm:p-5 flex flex-col justify-between">
  <div>
    <div class="mb-2 flex items-center justify-between gap-2 text-xs">
      <span class="rounded-md bg-[var(--brand-blue-soft)] px-2 py-0.5 font-semibold text-[var(--brand-blue)]">
        {entry.data.category}
      </span>
      <span class="text-[var(--text-muted)]">{readMinutes} 分钟</span>
    </div>
    <h3 class="mb-1.5 text-base font-bold leading-snug text-[var(--text-primary)]">
      <a href={url} class="hover:text-[var(--brand-blue)] transition-colors">
        {entry.data.title}
      </a>
    </h3>
    <p class="line-clamp-2 text-xs leading-relaxed text-[var(--text-secondary)]">
      {entry.data.excerpt ?? entry.data.description}
    </p>
  </div>
  <div class="mt-3 flex items-center justify-between pt-2.5 border-t border-slate-100 text-xs text-[var(--text-muted)]">
    <time datetime={entry.data.pubDate.toISOString()}>{formatZhDate(entry.data.pubDate)}</time>
    <a href={url} class="font-semibold text-[var(--brand-blue)] hover:underline">查看 →</a>
  </div>
</article>
