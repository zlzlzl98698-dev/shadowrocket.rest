---
import type { BrandPlan } from '@/data/brands';

export interface Props {
  brandName: string;
  plan: BrandPlan;
  brandSlug: string;
}

const { brandName, plan, brandSlug } = Astro.props;
---

<div class="editorial-card flex flex-col justify-between p-5">
  <div>
    <div class="mb-2 flex items-center justify-between gap-2">
      <span class="text-xs font-semibold text-[var(--brand-blue)]">{brandName}</span>
      <span class="rounded-full bg-[var(--bg-secondary)] px-2.5 py-0.5 text-xs font-medium text-[var(--text-secondary)]">
        {plan.billingCycle}
      </span>
    </div>

    <h3 class="mb-2 text-base font-bold text-[var(--text-primary)]">{plan.name}</h3>

    <div class="mb-3 flex items-baseline gap-1.5">
      <span class="text-2xl font-extrabold text-[var(--brand-navy)] font-mono-num">¥{plan.priceCny}</span>
      <span class="text-xs text-[var(--text-secondary)]">/ {plan.billingCycle}</span>
    </div>

    {plan.monthlyEquivalentCny && plan.billingCycle !== '月付' && (
      <div class="mb-2 rounded-lg bg-[var(--brand-blue-soft)] px-2.5 py-1 text-xs text-[var(--brand-blue)]">
        折算月均约 ¥{plan.monthlyEquivalentCny}/月（需按{plan.billingCycle}支付）
      </div>
    )}

    <div class="text-sm text-[var(--text-secondary)]">
      流量配额：<strong class="text-[var(--text-primary)]">{plan.trafficDisplay}</strong>（{plan.trafficReset}）
    </div>
    {plan.discountNote && (
      <p class="mt-1.5 text-xs text-[var(--text-muted)]">{plan.discountNote}</p>
    )}
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
    <span class="text-[var(--text-muted)]">
      {plan.dataStatus === 'historical' ? '历史存档价' : '品牌资料'}
    </span>
    <a href={`/brands/${brandSlug}/`} class="font-semibold text-[var(--brand-blue)] hover:underline">
      核实详情 →
    </a>
  </div>
</div>
