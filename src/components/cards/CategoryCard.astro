---
import type { PillarNav } from '@/data/navigation';

export interface Props {
  pillar: PillarNav;
  articleCount?: number;
}

const { pillar, articleCount } = Astro.props;

const iconMap = {
  airport: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  vpn: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  clash: 'M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z',
  resources: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z',
};
---

<a href={pillar.href} class="editorial-card group flex flex-col justify-between p-6">
  <div>
    <div class="mb-4 flex items-center justify-between">
      <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--brand-blue-soft)] text-[var(--brand-blue)] group-hover:bg-[var(--brand-blue)] group-hover:text-white transition-colors">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconMap[pillar.key]} />
        </svg>
      </div>
      <span class="rounded-full bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-secondary)]">
        {pillar.items.length} 个专题
      </span>
    </div>

    <h3 class="mb-1.5 text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-blue)] transition-colors">
      {pillar.name}
    </h3>
    <p class="mb-3 text-xs font-medium text-[var(--brand-blue)]">{pillar.subtitle}</p>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
      {pillar.description}
    </p>
  </div>

  <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-3.5 text-xs font-semibold text-[var(--brand-blue)]">
    <span>{articleCount !== undefined ? `${articleCount} 篇核心内容` : '进入频道'}</span>
    <span class="transition-transform group-hover:translate-x-1">探索专题 →</span>
  </div>
</a>
