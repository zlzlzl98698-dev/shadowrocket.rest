---
import type { AnyEntry } from '@/utils/content';
import { formatZhDate, getEntryUrl } from '@/utils/content';

export interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const url = getEntryUrl(entry);
const compared = 'comparedEntities' in entry.data ? entry.data.comparedEntities : [];
---

<article class="editorial-card flex flex-col justify-between p-6">
  <div>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <span class="rounded-full bg-indigo-50 px-3 py-0.5 text-xs font-semibold text-indigo-700">
        横向对比
      </span>
      <time class="text-xs text-[var(--text-muted)]" datetime={entry.data.pubDate.toISOString()}>
        {formatZhDate(entry.data.pubDate)}
      </time>
    </div>

    <h3 class="mb-2 text-lg font-bold leading-snug text-[var(--text-primary)]">
      <a href={url} class="hover:text-[var(--brand-blue)] transition-colors">{entry.data.title}</a>
    </h3>

    <p class="mb-4 text-sm leading-relaxed text-[var(--text-secondary)] line-clamp-2">
      {entry.data.excerpt ?? entry.data.description}
    </p>

    {compared.length > 0 && (
      <div class="mb-4 flex flex-wrap gap-1.5">
        {compared.map((name) => (
          <span class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-primary)]">
            {name}
          </span>
        ))}
      </div>
    )}
  </div>

  <div class="flex items-center justify-between border-t border-slate-100 pt-3.5 text-xs">
    <span class="text-[var(--text-secondary)]">关键参数与适用人群对比</span>
    <a href={url} class="font-semibold text-[var(--brand-blue)] hover:underline">查看对比表 →</a>
  </div>
</article>
