---
import type { AnyEntry } from '@/utils/content';
import { estimateReadingMinutes, formatZhDate, getEntryUrl } from '@/utils/content';

export interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const url = getEntryUrl(entry);
const readMinutes = estimateReadingMinutes(entry.body);
---

<article class="editorial-card overflow-hidden flex flex-col">
  <a href={url} class="relative block aspect-16/9 w-full overflow-hidden bg-slate-900">
    <img
      src={entry.data.cover}
      alt={entry.data.coverAlt ?? entry.data.title}
      class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
    <span class="absolute left-3 top-3 rounded-full bg-slate-900/85 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
      深度评测
    </span>
  </a>
  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <div class="mb-2 flex items-center gap-2 text-xs text-[var(--text-secondary)]">
        <span class="font-semibold text-[var(--brand-blue)]">{entry.data.category}</span>
        <span>·</span>
        <span>{readMinutes} 分钟阅读</span>
        {entry.data.testDate && (
          <>
            <span>·</span>
            <span>测试：{entry.data.testDate}</span>
          </>
        )}
      </div>
      <h3 class="mb-2 text-lg font-bold leading-snug text-[var(--text-primary)]">
        <a href={url} class="hover:text-[var(--brand-blue)] transition-colors">{entry.data.title}</a>
      </h3>
      <p class="mb-4 line-clamp-2 text-sm text-[var(--text-secondary)]">
        {entry.data.excerpt ?? entry.data.description}
      </p>
    </div>
    <div class="flex items-center justify-between border-t border-slate-100 pt-3 text-xs">
      <time class="text-[var(--text-muted)]" datetime={entry.data.pubDate.toISOString()}>
        {formatZhDate(entry.data.pubDate)}
      </time>
      <a href={url} class="font-semibold text-[var(--brand-blue)] hover:underline">查看实测报告 →</a>
    </div>
  </div>
</article>
