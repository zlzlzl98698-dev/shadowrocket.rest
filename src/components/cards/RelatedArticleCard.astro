---
import type { AnyEntry } from '@/utils/content';
import { formatZhDate, getEntryUrl, getKindLabel } from '@/utils/content';

export interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const url = getEntryUrl(entry);
---

<a
  href={url}
  class="group flex items-start gap-3.5 rounded-xl border border-[var(--border-color)] bg-white p-4 hover:border-[var(--brand-blue)] hover:shadow-sm transition-all"
>
  <img
    src={entry.data.cover}
    alt={entry.data.coverAlt ?? entry.data.title}
    class="h-16 w-24 shrink-0 rounded-lg object-cover bg-slate-100"
    loading="lazy"
    decoding="async"
  />
  <div class="min-w-0 flex-1">
    <div class="mb-1 flex items-center gap-2 text-[11px] text-[var(--text-secondary)]">
      <span class="font-semibold text-[var(--brand-blue)]">{getKindLabel(entry.kind)}</span>
      <span>·</span>
      <time datetime={entry.data.pubDate.toISOString()}>{formatZhDate(entry.data.pubDate)}</time>
    </div>
    <h4 class="line-clamp-2 text-sm font-bold leading-snug text-[var(--text-primary)] group-hover:text-[var(--brand-blue)] transition-colors">
      {entry.data.title}
    </h4>
  </div>
</a>
